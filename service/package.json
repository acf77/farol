{
  "name": "farol-service",
  "version": "0.1.0",
  "private": true,
  "description": "Farol run service: runs pipelines in Railway Sandboxes over HTTP.",
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "build": "node scripts/sync-shared.mjs && esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/farol-service.cjs",
    "typecheck": "node scripts/sync-shared.mjs && tsc --noEmit -p tsconfig.json",
    "test": "node scripts/sync-shared.mjs && vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
