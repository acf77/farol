{
  "jsPlugins": [
    {
      "name": "complexity",
      "specifier": "./app/node_modules/oxlint-plugin-complexity/dist/index.js"
    }
  ],
  "ignorePatterns": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.tsx"
  ],
  "rules": {
    "complexity/complexity": [
      "error",
      {
        "cyclomatic": 20,
        "cognitive": 15
      }
    ]
  }
}
