{
  "name": "farol",
  "version": "0.3.6",
  "private": true,
  "author": "Farol",
  "description": "A terminal workspace with runnable shell + AI pipelines.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --mac dmg zip && node scripts/publish-local.mjs",
    "dist:alpha": "electron-vite build && electron-builder --mac dmg zip -c.appId=com.farol.app.alpha \"-c.productName=Farol Alpha\" -c.directories.output=dist-alpha \"-c.dmg.title=Farol Alpha ${version}\"",
    "service:build": "esbuild service/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=service/dist/farol-service.cjs",
    "install:app": "npm run dist && node scripts/install-app.mjs",
    "release": "electron-vite build && electron-builder --mac dmg zip --publish always '-c.mac.artifactName=Farol-mac-${arch}.${ext}'"
  },
  "build": {
    "appId": "com.farol.app",
    "productName": "Farol",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": true,
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "CFBundleIconFile": "icon",
        "CFBundleIconName": "icon"
      },
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "timestamp": "none",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Farol ${version}"
    },
    "publish": {
      "provider": "github",
      "owner": "acf77",
      "repo": "farol",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.85",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vercel/sandbox": "^3.5.1",
    "ai": "^7.0.105",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "node-pty": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@electron/rebuild": "^3.7.0",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-query": "^5.103.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cypress": "^16.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "eslint": "^10.9.1",
    "jsdom": "^30.1.1",
    "oxlint-plugin-complexity": "^2.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.11",
    "vitest": "^4.1.10",
    "@types/bun": "latest"
  }
}
